# {{ ansible_managed }}
# The configuration of instance {{ instance.name }}, made from config.demo.yaml of the repository.
# The proxy over the SQLite demo backend (rpp_backend: sqlite): bare RPP with the demo objects Planet and Satellite of
# the extension org.example.rpp.extension.planets (docs/demo/planets-extension.md). It runs without a registry.
rpp_backend: sqlite

# The database: a file in the data directory of the instance (data: true), which the workers of the instance share.
rpp_sqlite_url: sqlite:////data/{{ instance.sqlite_file | default('demo.db') }}

# The clients: the user of the Basic authentication, and the hash of its password (`scrypt$...`, made by
# `python -m registry_adapter.sqlite.hash_password`). The user is the sponsoring client of what it creates. From the
# vault, never the demo hashes of config.demo.yaml.
rpp_sqlite_clients:
{% for user, hash in instance.sqlite_clients | dictsort %}
  {{ user }}: {{ hash | to_json }}
{% endfor %}

# The extensions this deployment is built with: the module paths of the extension packages. Each registers its schema,
# paths, handlers, objects, SQLite part and profile leaves. Without them the proxy does not know the extension.
rpp_extensions:
  - extensions.planets

rpp_profile_signalling: header

# The profile of this server: src/settings/profiles/sqlite.yaml, which holds none of the drafts' objects, and what the
# planets extension adds. The RPP profile `demo` is the one the extension brings.
rpp_backend_profile:
  extends: sqlite
  profiles:
    - base
    - demo
  default_profile: demo

# The OpenAPI document served shows only what the demo serves: not the operations on the drafts' objects, which the demo
# backend does not hold, nor those no handler serves. Against the drafts' API contract, which lists them all; requests to
# them still answer 501 (#204).
rpp_openapi_omit_unheld_objects: true
rpp_openapi_omit_unimplemented: true

# What the discovery document states.
rpp_base_url: {{ instance.base_url }}
rpp_tlds: {{ instance.tlds | default(['example']) | to_json }}
rpp_environment_name: {{ instance.environment_name | default(instance.base_url | urlsplit('hostname')) }}
rpp_environment_status: {{ instance.environment_status | default('test') }}
