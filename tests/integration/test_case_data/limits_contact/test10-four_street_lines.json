{
  "test_id": "test10-four_street_lines",
  "when": {
    "env.contact.street.max_count": 3
  },
  "comment": "Skipped on rri-mtest: MTEST's limit of street lines is not known (null), and the 501 is the EPP Compatibility Profile's.",
  "description": "Four street lines, over the three of the EPP Compatibility Profile: 501 (spec-issues.md).",
  "steps": [
    {
      "comment": "Creates contact Z10 with authInfo (by backend); expects 422 02308 under the EPP compatible preset where the proxy checks the EPP Compatibility Profile, else 501 02102. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:Z10}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "name",
                    "value": "Haus B"
                  },
                  {
                    "kind": "name",
                    "value": "Stock 3"
                  },
                  {
                    "kind": "name",
                    "value": "Zimmer 4"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible",
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error",
                "errors": [
                  {
                    "result": "02308",
                    "profile": "urn:ietf:params:rpp:profile:epp-compatibility",
                    "paths": [
                      "$.contactInfo.addresses.addr.components"
                    ]
                  }
                ]
              }
            }
          },
          {
            "then": {
              "status": 501,
              "content_type": "application/problem+json",
              "headers": {
                "RPP-Code": "02102"
              },
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
