{
  "test_id": "test32-patch_add_existing_address",
  "setup": [
    {
      "comment": "Creates domain t32 with authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t32-{random_name}.{tld}"
      }
    },
    {
      "comment": "Creates host ns1.t32 with dns records ns, a; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "ns1.t32-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns1.t32-{random_name}.{tld}."
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.t32-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host ns1.t32: add /dns/records; expects 200 01000 where the server takes adding an address the host has as no change, else 422 02306. The answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/ns1.t32-{random_name}.{tld}",
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "ns1.t32-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          }
        ],
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.update.add_existing_supported": true
            },
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "content_type": "application/rpp+json",
              "body": {
                "@type": "host",
                "hostName": "ns1.t32-{random_name}.{tld}"
              }
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
