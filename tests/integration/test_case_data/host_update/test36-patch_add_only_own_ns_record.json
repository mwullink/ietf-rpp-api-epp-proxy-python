{
  "test_id": "test36-patch_add_only_own_ns_record",
  "setup": [
    {
      "comment": "Creates host t36.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t36.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t36.….net: add /dns/records; expects 200 01000 where the proxy checks the EPP Compatibility Profile (it applies the patch to the host read, which has it), else 400 02003. The answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t36.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "t36.{random_name}.net."
              }
            }
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible",
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "content_type": "application/rpp+json",
              "body": {
                "@type": "host"
              }
            }
          },
          {
            "then": {
              "status": 400,
              "headers": {
                "RPP-Code": "02003"
              },
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "content_type": "application/problem+json"
            }
          }
        ]
      }
    }
  ]
}
