{
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "admin"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts.",
  "test_id": "test11-ambiguous_replace",
  "setup": [
    {
      "comment": "Creates contact uj1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uj1}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "US"
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            }
          }
        },
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates contact uj2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uj2}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "US"
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            }
          }
        },
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates domain up-test11 with authInfo, registrant uj1, contacts admin, tech, tech (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "up-test11-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:uj1}"
        },
        "contacts": {
          "select": [
            {
              "when": {
                "profile.domainName.contacts.labels": {
                  "contains": "admin"
                }
              },
              "then": [
                {
                  "label": "admin",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uj1}"
                  }
                },
                {
                  "label": "tech",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uj1}"
                  }
                },
                {
                  "label": "tech",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uj2}"
                  }
                }
              ]
            },
            {
              "omit": true
            }
          ]
        },
        "dns": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.10"
                    }
                  }
                ]
              }
            },
            {
              "omit": true
            }
          ]
        },
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Abc2345678"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain up-test11: replace /contacts with a match billing; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test11-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contacts",
            "match": {
              "label": "tech"
            },
            "value": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "{handle:a:uj1}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error",
          "status": 422,
          "errors": [
            {
              "result": "02308"
            }
          ]
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    }
  ]
}
