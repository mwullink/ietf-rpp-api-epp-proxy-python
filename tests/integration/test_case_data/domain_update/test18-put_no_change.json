{
  "markers": [
    "smoke"
  ],
  "test_id": "test18-put_no_change",
  "setup": [
    {
      "comment": "Creates contact ul1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:ul1}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "US"
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            }
          }
        },
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates domain put18 with authInfo, registrant ul1, dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put18-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:ul1}"
        },
        "dns": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.10"
                    }
                  }
                ]
              }
            },
            {
              "omit": true
            }
          ]
        },
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Abc2345678"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put18 by a full update with registrant ul1, dns records a (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put18-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:ul1}"
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:ul1}"
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
