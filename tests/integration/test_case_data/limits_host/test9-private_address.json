{
  "test_id": "test9-private_address",
  "description": "A private address: a server MAY refuse it (data-objects); this one takes it.",
  "setup": [
    {
      "comment": "Creates contact Y9 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Y9}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates domain h9 with authInfo, registrant Y9 (by backend), dns records a (by backend); expects 201. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "h9-{random_name}.{tld}",
        "registrant": {
          "select": [
            {
              "when": {
                "profile.domainName.registrant.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:Y9}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "dns": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.10"
                    }
                  }
                ]
              }
            },
            {
              "omit": true
            }
          ]
        },
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Abc2345678"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.h9 with dns records ns, a; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.h9-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.h9-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h9-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "10.0.0.1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        }
      }
    }
  ]
}
