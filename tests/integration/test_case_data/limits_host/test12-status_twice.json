{
  "test_id": "test12-status_twice",
  "description": "The same client status added twice in one PATCH: the proxy sends both, and the server refuses the second as one that exists, or takes it as no change.",
  "setup": [
    {
      "comment": "Creates host h12.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "h12.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host h12.….net: add /status clientDeleteProhibited; add /status clientDeleteProhibited; expects 200 01000 where the proxy checks the EPP Compatibility Profile (it applies the patch to the host read, which has it), else 200 01000 where the server takes adding a status the host has once the first add is applied as no change, else 422 02306. The answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/h12.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible",
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "content_type": "application/rpp+json",
              "body": {
                "@type": "host",
                "status": [
                  {
                    "label": "clientDeleteProhibited"
                  }
                ]
              }
            }
          },
          {
            "when": {
              "env.update.add_existing_supported": true
            },
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "content_type": "application/rpp+json"
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
