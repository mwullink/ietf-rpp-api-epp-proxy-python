{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    }
  },
  "comment": "Skipped where a domain cannot be transferred. On RRI the transfer is CHPROV with the de.denic.rpp.rri extension (#190): its steps say where they run.",
  "test_id": "test6-read_head_then_ack",
  "steps": [
    {
      "comment": "Creates contact HM6; expects 201. Setup: the registrant of the domain below. Only where a domain needs a registrant.",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HM6}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Creates request contact GM6 with uriTemplate; expects 201 01000. Setup: the General Request contact of the domain below. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:GM6}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:GM6}"
        }
      }
    },
    {
      "comment": "Creates request contact AM6 with uriTemplate; expects 201 01000. Setup: the Abuse contact of the domain below. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:AM6}",
          "uriTemplate": "mailto:abuse@example.com"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:AM6}"
        }
      }
    },
    {
      "comment": "Creates domain ms6 with authInfo, registrant HM6, dns records a, and on RRI its request contacts GM6 and AM6 (all by backend); expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "ms6-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HM6}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "generalRequest": {
            "select": [
              {
                "when": {
                  "profile.extensions": {
                    "contains": "de.denic.rpp.rri"
                  }
                },
                "then": {
                  "@type": "requestContact",
                  "id": "{handle:a:GM6}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "abuse": {
            "select": [
              {
                "when": {
                  "profile.extensions": {
                    "contains": "de.denic.rpp.rri"
                  }
                },
                "then": {
                  "@type": "requestContact",
                  "id": "{handle:a:AM6}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Creates contact HM6 of registrar b as registrar b; expects 201 01000. Setup: the registrant the transfer below gives the domain. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:b:HM6}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contact",
          "id": "{handle:b:HM6}"
        }
      }
    },
    {
      "comment": "Creates request contact GM6 of registrar b as registrar b; expects 201 01000. Setup: the General Request contact the transfer below gives the domain. Only on RRI, whose transfer carries the domain data.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:b:GM6}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:b:GM6}"
        }
      }
    },
    {
      "comment": "Creates request contact AM6 of registrar b as registrar b; expects 201 01000. Setup: the Abuse contact the transfer below gives the domain. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:b:AM6}",
          "uriTemplate": "mailto:abuse@example.com"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:b:AM6}"
        }
      }
    },
    {
      "comment": "Requests a transfer of domain ms6 as registrar b; expects 201 01001, a pending transfer, which queues a message for registrar a. Setup: the message the steps below read and acknowledge. Only where the transfer is EPP's.",
      "when": {
        "profile.extensions": {
          "not": {
            "contains": "de.denic.rpp.rri"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "/domainNames/ms6-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Transfers domain ms6 by CHPROV with registrant, generalRequest, abuse, dns as registrar b; expects 200 01000, serverApproved at once. Setup: a message for registrar a, the losing registrar, for the steps below; the shared MTEST queue holds older ones too. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/domainNames/ms6-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "registrant": {
            "@type": "contact",
            "id": "{handle:b:HM6}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:b:GM6}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:b:AM6}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "trStatus": "serverApproved",
          "reqClientId": "{regacc:b}",
          "actClientId": "{regacc:b}"
        },
        "fields": {
          "requestDate": {
            "type": "not_null"
          },
          "actionDate": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "comment": "Polls the message queue; expects 200 01301 with a message at the head (on a shared test queue an older one may come first). The operation this case checks. Keeps head for later steps.",
      "request": {
        "method": "GET",
        "url": "/messages",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": [
          {
            "@type": "message",
            "status": "queued"
          }
        ],
        "fields": {
          "0.id": {
            "type": "not_empty_string"
          }
        },
        "headers": {
          "RPP-Code": "01301",
          "RPP-Queue-Size": {
            "type": "not_null"
          }
        }
      },
      "capture": {
        "head": "0.id"
      }
    },
    {
      "comment": "Acknowledges message the captured head; expects 200 01000, with RPP-Queue-Size, except where the proxy does not state it (bugs.queue_del_no_msgcnt, #172). The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/messages/{capture:head}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Queue-Size": {
            "select": [
              {
                "when": {
                  "env.bugs.queue_del_no_msgcnt": false
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "Content-Type": null
        }
      }
    },
    {
      "comment": "Acknowledges message the captured head; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/messages/{capture:head}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02303"
        }
      }
    },
    {
      "comment": "Deletes domain ms6 as registrar b, its sponsor after the transfer; expects 200. Cleanup: MTEST keeps what a case creates, so the case deletes it. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ms6-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
