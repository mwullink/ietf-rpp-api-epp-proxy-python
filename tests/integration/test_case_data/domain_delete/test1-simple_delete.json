{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-simple_delete",
  "setup": [
    {
      "comment": "Creates contact HD1; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HD1}"
      }
    },
    {
      "comment": "Creates domain test1 with authInfo, registrant HD1 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "test1-{random_name}.{tld}",
        "registrant": {
          "select": [
            {
              "when": {
                "profile.domainName.registrant.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:HD1}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "dns": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.10"
                    }
                  }
                ]
              }
            },
            {
              "omit": true
            }
          ]
        },
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Abc2345678"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain test1; expects 200. The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test1-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
