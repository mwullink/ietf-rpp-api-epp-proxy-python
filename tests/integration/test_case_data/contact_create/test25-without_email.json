{
  "test_id": "test25-without_email",
  "description": "A contact without an email is refused: RFC 5733 requires one.",
  "steps": [
    {
      "comment": "Creates contact K25 with authInfo (by backend); expects 422 02308 under the EPP compatible preset where the proxy checks the EPP Compatibility Profile, else one of 400 02001 or 400 02003 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:K25}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible",
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error",
                "errors": [
                  {
                    "result": "02308",
                    "profile": "urn:ietf:params:rpp:profile:epp-compatibility",
                    "paths": [
                      "$.contactInfo"
                    ]
                  }
                ]
              }
            }
          },
          {
            "then": {
              "any_of": [
                {
                  "status": 400,
                  "headers": {
                    "RPP-Code": "02001"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                },
                {
                  "status": 400,
                  "headers": {
                    "RPP-Code": "02003"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                },
                {
                  "status": 400,
                  "headers": {
                    "RPP-Code": "02005"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                },
                {
                  "status": 422,
                  "headers": {
                    "RPP-Code": "02306"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
