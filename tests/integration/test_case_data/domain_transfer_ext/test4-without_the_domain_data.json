{
  "test_id": "test4-without_the_domain_data",
  "description": "The extension requires the registrant and the DNS data.",
  "setup": [
    {
      "comment": "Creates request contact RG11 with uriTemplate; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG11}"
      }
    },
    {
      "comment": "Creates request contact RA11 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA11}",
        "uriTemplate": "mailto:abuse@example.com"
      }
    },
    {
      "comment": "Creates contact XT4; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:XT4}"
      }
    },
    {
      "comment": "Creates domain x4 with registrant XT4, generalRequest, abuse, dns records a, authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "x4-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:XT4}"
        },
        "abuse": {
          "@type": "requestContact",
          "id": "{handle:a:RA11}"
        },
        "generalRequest": {
          "@type": "requestContact",
          "id": "{handle:a:RG11}"
        },
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "a",
              "rdata": {
                "address": "192.0.2.10"
              }
            }
          ]
        },
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Abc2345678"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain x4 as registrar b; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/x4-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02001"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain x4; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "x4-{random_name}.{tld}"
      }
    }
  ]
}
