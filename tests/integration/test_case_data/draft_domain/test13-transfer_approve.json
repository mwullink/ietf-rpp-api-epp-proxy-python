{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "approve"
    }
  },
  "comment": "Skipped on rri-mtest: RRI's transfer (CHPROV) is immediate, without a pending transfer to query, approve, cancel or reject.",
  "test_id": "test13-transfer_approve",
  "exclusive": [
    "message_queue"
  ],
  "steps": [
    {
      "comment": "Creates contact HR13; expects 201. Setup: the registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HR13}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Creates domain ex13 with authInfo, registrant HR13 (by backend), dns records a (by backend); expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "ex13-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HR13}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Requests a transfer of domain ex13 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex13-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Approves the pending transfer of domain ex13; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex13-{random_name}.{tld}/processes/transferProcesses/latest/transferApprove",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainTransferProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "clientApproved"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
