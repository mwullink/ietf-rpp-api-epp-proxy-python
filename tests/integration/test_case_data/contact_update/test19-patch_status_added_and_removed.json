{
  "when": {
    "profile.contact.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a contact.",
  "test_id": "test19-patch_status_added_and_removed",
  "setup": [
    {
      "comment": "Creates contact 19A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:19A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 19A: add /status clientDeleteProhibited; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:19A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "contactStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:19A}",
          "status": [
            {
              "label": "clientDeleteProhibited"
            }
          ]
        }
      }
    },
    {
      "comment": "Patches contact 19A: remove /status with a match; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:19A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/status",
            "match": {
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:19A}",
          "status": [
            {
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "comment": "Patches contact 19A: remove /status with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:19A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/status",
            "match": {
              "@type": "contactStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Patches contact 19A: remove /status with a match; expects 422 02308 where the proxy checks the EPP Compatibility Profile (it applies the patch to the contact read, where no element matches), else 200 01000 where the server takes removing a status the contact lacks as no change, else 422 02306. The answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:19A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/status",
            "match": {
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible",
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "when": {
              "env.update.remove_absent_supported": true
            },
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "content_type": "application/rpp+json",
              "body": {
                "@type": "contact",
                "id": "{handle:a:19A}"
              }
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
