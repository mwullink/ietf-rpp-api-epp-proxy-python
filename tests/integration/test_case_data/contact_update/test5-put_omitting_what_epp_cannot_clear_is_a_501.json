{
  "when": [
    {
      "profile.contact.name.removable": false
    },
    {
      "env.contact.name.min_count": {
        "min": 1
      }
    }
  ],
  "test_id": "test5-put_keeps_what_epp_cannot_clear",
  "description": "A full update is the wanted state (core §16.8), so the name, address and email it omits are cleared, which EPP cannot do: 501, see spec-issues.md (Full update of a contact).",
  "setup": [
    {
      "comment": "Creates contact 05A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:05A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact 05A by a full update; expects 422 02308 where the proxy checks the EPP Compatibility Profile, 501 02102 where EPP cannot clear it and the server checks the profile, else 422 02306. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:05A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "phones": {
              "voice": {
                "number": "tel:+49.777777777"
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            }
          }
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.contact.name.removable": false,
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error",
                "errors": [
                  {
                    "result": "02308",
                    "profile": "urn:ietf:params:rpp:profile:epp-compatibility",
                    "paths": [
                      "$.contactInfo"
                    ]
                  }
                ]
              }
            }
          },
          {
            "when": {
              "profile.contact.name.removable": false
            },
            "then": {
              "status": 501,
              "headers": {
                "RPP-Code": "02102"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
