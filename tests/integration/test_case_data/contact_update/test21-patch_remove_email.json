{
  "when": [
    {
      "profile.contact.email.removable": false
    },
    {
      "env.contact.email.min_count": {
        "min": 1
      }
    }
  ],
  "test_id": "test21-patch_remove_email",
  "setup": [
    {
      "comment": "Creates contact 21A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:21A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 21A: remove /contactInfo/emails/email; expects 422 02308 where the proxy checks the EPP Compatibility Profile, 501 02102 where EPP cannot clear it and the server checks the profile, else 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:21A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/emails/email"
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.contact.email.removable": false,
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error",
                "errors": [
                  {
                    "result": "02308",
                    "profile": "urn:ietf:params:rpp:profile:epp-compatibility",
                    "paths": [
                      "$.contactInfo.emails"
                    ]
                  }
                ]
              }
            }
          },
          {
            "when": {
              "profile.contact.email.removable": false
            },
            "then": {
              "status": 501,
              "headers": {
                "RPP-Code": "02102"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
