{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-put_replaces_data",
  "setup": [
    {
      "comment": "Creates contact 01A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:01A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "select": [
                    {
                      "when": {
                        "profile.contact.region.supported": true
                      },
                      "then": {
                        "kind": "region",
                        "value": "PA"
                      }
                    },
                    {
                      "omit": true
                    }
                  ]
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.123123123"
            },
            "fax": {
              "select": [
                {
                  "when": {
                    "profile.contact.fax.supported": true
                  },
                  "then": {
                    "number": "tel:+49.456456456",
                    "features": {
                      "fax": true
                    }
                  }
                },
                {
                  "omit": true
                }
              ]
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          }
        },
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact 01A by a full update (the request differs by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:01A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Bonn"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "NW"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "53111"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.999999999"
              }
            },
            "emails": {
              "email": {
                "address": "new@example.com"
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:01A}",
          "contactInfo": {
            "emails": {
              "email": {
                "address": "new@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.999999999"
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Bonn"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "NW"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "53111"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "comment": "Reads contact 01A; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:01A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "contactInfo": {
            "emails": {
              "email": {
                "address": "new@example.com"
              }
            },
            "name": {
              "full": "John Doe"
            }
          }
        }
      }
    }
  ]
}
