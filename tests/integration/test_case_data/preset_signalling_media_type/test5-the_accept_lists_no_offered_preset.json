{
  "markers": [
    "smoke"
  ],
  "test_id": "test5-the_accept_lists_no_offered_profile",
  "description": "An Accept without a preset the server offers (an unknown preset or version, a weight of 0, another media type) is 406 with RPP-Code 02004 (core 14.3).",
  "when": {
    "env.preset_signalling": "media-type"
  },
  "comment": "Skipped on epp-docker: the EPP config signals the preset by the RPP-Preset header; preset_signalling_header/ covers the header method.",
  "steps": [
    {
      "comment": "Reads the discovery document, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:example:nope\"; preset-version=\"1.0\"; expects 406 02004. An error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:example:nope\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 406,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": {"type": "list_contains", "values": ["Accept"]}
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads the discovery document, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"2.0\"; expects 406 02004. An error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"2.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 406,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": {"type": "list_contains", "values": ["Accept"]}
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads the discovery document, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; q=0; expects 406 02004. An error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; q=0",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 406,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": {"type": "list_contains", "values": ["Accept"]}
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads the discovery document, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\", Accept text/html; expects 406 02004. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "text/html",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 406,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": {"type": "list_contains", "values": ["Accept"]}
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
