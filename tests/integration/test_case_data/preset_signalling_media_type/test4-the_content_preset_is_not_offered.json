{
  "markers": [
    "smoke"
  ],
  "test_id": "test4-the_content_preset_is_not_offered",
  "description": "A preset or version of the Content-Type that the server does not offer is 415 with RPP-Code 02004, a Problem Detail without preset parameters and Accept in Vary, on a request with content and on one without (core 14.3).",
  "when": {
    "env.preset_signalling": "media-type"
  },
  "comment": "Skipped on epp-docker: the EPP config signals the preset by the RPP-Preset header; preset_signalling_header/ covers the header method.",
  "steps": [
    {
      "comment": "Creates contact PB4, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"2.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; expects 415 02004. An error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"2.0\""
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:PB4}"
        }
      },
      "response": {
        "status": 415,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept, Origin"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Creates contact PB4, with Content-Type application/rpp+json; preset=\"urn:example:nope\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; expects 415 02004. An error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:example:nope\"; preset-version=\"1.0\""
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:PB4}"
        }
      },
      "response": {
        "status": 415,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept, Origin"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads domain b4, with Content-Type application/rpp+json; preset=\"urn:example:nope\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; expects 415 02004. An error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/b4-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:example:nope\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 415,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept, Origin"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads domain b4, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:epp-compatible\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; expects 415 02004. An error answer this case checks. Only where the server offers no epp-compatible preset (rri-mtest).",
      "when": {
        "profile.presets": {
          "not": {
            "contains": "epp-compatible"
          }
        }
      },
      "request": {
        "method": "GET",
        "url": "/domainNames/b4-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:epp-compatible\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 415,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept, Origin"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads domain b4, with Content-Type application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; expects 415 02004. The error answer this case checks. Only where the server offers no rri preset (epp-docker).",
      "when": {
        "profile.presets": {
          "not": {
            "contains": "rri"
          }
        }
      },
      "request": {
        "method": "GET",
        "url": "/domainNames/b4-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 415,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept, Origin"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
