{
  "when": {
    "profile.domainName.processes.restore.report_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI's RESTORE is one step, without a restore report.",
  "test_id": "test9-report_with_one_statement",
  "steps": [
    {
      "comment": "Sends a restore report for domain rs9; expects 422 02308 under the EPP compatible preset where the proxy checks the EPP Compatibility Profile, else 400 02001. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/rs9-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess",
          "restoreReport": {
            "@type": "restoreReport",
            "preData": "Pre-delete registration data.",
            "postData": "Post-restore registration data.",
            "deleteTime": "2026-01-10T12:00:00.0Z",
            "restoreTime": "2026-01-20T15:30:00.0Z",
            "restoreReason": "Domain deleted in error by client operator.",
            "statements": [
              "The information in this report is true to the best of my knowledge."
            ]
          }
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible",
              "profile.informational_profiles": {
                "not": {
                  "contains": "epp-compatibility"
                }
              }
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308",
                "RPP-Cltrid": {
                  "type": "not_empty_string"
                }
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error",
                "errors": [
                  {
                    "result": "02308",
                    "profile": "urn:ietf:params:rpp:profile:epp-compatibility",
                    "paths": [
                      "$.restoreReport.statements"
                    ]
                  }
                ]
              }
            }
          },
          {
            "then": {
              "status": 400,
              "content_type": "application/problem+json",
              "headers": {
                "RPP-Code": "02001",
                "RPP-Cltrid": {
                  "type": "not_empty_string"
                }
              },
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
