{
  "test_id": "test13-status_twice",
  "when": {
    "profile.domainName.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a domain.",
  "description": "The same client status added twice in one PATCH: the proxy sends the end state, one status.",
  "setup": [
    {
      "comment": "Creates contact X13 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X13}"
      }
    },
    {
      "comment": "Creates domain t13 with authInfo, registrant X13 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t13-{random_name}.{tld}",
        "registrant": {
          "select": [
            {
              "when": {
                "profile.domainName.registrant.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:X13}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "dns": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.10"
                    }
                  }
                ]
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t13: add /status clientHold; add /status clientHold; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t13-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientHold"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientHold"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {}
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t13; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t13-{random_name}.{tld}"
      }
    }
  ]
}
