{
  "test_id": "test19-sixth_tech_contact_by_update",
  "skip": "pawel-kow/epp#29",
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "tech"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts.",
  "description": "A sixth tech contact added to a domain with five: the limit holds for the domain, not the command.",
  "setup": [
    {
      "comment": "Creates contact Qa2 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qa2}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates contact Qb2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qb2}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates contact Qc2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qc2}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates contact Qd2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qd2}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates contact Qe2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qe2}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates contact Qf2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qf2}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "Abc2345678"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    },
    {
      "comment": "Creates domain t19 with authInfo, registrant Qa2 (by backend), dns records a (by backend), contacts tech, tech, tech, tech, tech; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t19-{random_name}.{tld}",
        "registrant": {
          "select": [
            {
              "when": {
                "profile.domainName.registrant.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:Qa2}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "contacts": [
          {
            "label": "tech",
            "object": {
              "@type": "contact",
              "id": "{handle:a:Qa2}"
            }
          },
          {
            "label": "tech",
            "object": {
              "@type": "contact",
              "id": "{handle:a:Qb2}"
            }
          },
          {
            "label": "tech",
            "object": {
              "@type": "contact",
              "id": "{handle:a:Qc2}"
            }
          },
          {
            "label": "tech",
            "object": {
              "@type": "contact",
              "id": "{handle:a:Qd2}"
            }
          },
          {
            "label": "tech",
            "object": {
              "@type": "contact",
              "id": "{handle:a:Qe2}"
            }
          }
        ],
        "dns": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.10"
                    }
                  }
                ]
              }
            },
            {
              "omit": true
            }
          ]
        },
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Abc2345678"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t19: add /contacts tech; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t19-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qf2}"
              }
            }
          }
        ]
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
