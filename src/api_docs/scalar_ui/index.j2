<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>RPP API</title>
    <style>
      /* the link that opens the document in Scalar's hosted client, which no option hides (#205) */
      .open-api-client-button { display: none !important; }
    </style>
  </head>
  <body>
    <div id="app"></div>
    <script id="rpp-ui-configuration" type="application/json">{{ configuration|tojson }}</script>
    <script src="./standalone.js" charset="UTF-8"></script>
    <script>
      Scalar.createApiReference("#app", JSON.parse(document.getElementById("rpp-ui-configuration").textContent));
    </script>
  </body>
</html>
